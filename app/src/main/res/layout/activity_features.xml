<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Flutter 混合导航 Demo"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_open_ai_chat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:paddingVertical="16dp"
            android:text="AI 聊天 (/model_setup)"
            android:textSize="16sp" />

        <Button
            android:id="@+id/button_open_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingVertical="16dp"
            android:text="设置模块 (/settings)"
            android:textSize="16sp" />

        <Button
            android:id="@+id/button_open_agreement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingVertical="16dp"
            android:text="用户协议 (/agreement)"
            android:textSize="16sp" />

        <Button
            android:id="@+id/button_open_webview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingVertical="16dp"
            android:text="高质量 WebView 组件"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/text_nav_test_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="跳转和回退测试"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_nav_case_1"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="1. 原生 -> Flutter" />

        <Button
            android:id="@+id/button_nav_case_2"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="2. 原生 -> Flutter -> Flutter" />

        <Button
            android:id="@+id/button_nav_case_3"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="3. 原生 -> Flutter -> 原生" />

        <Button
            android:id="@+id/button_nav_case_4"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="32dp"
            android:text="4. 原生 -> Flutter -> Flutter -> 原生" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
